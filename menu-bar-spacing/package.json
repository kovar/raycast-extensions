{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "menu-bar-spacing",
  "title": "macOS Menu Bar Spacing",
  "description": "Adjust spacing between macOS menu bar items via hidden system preferences",
  "license": "MIT",
  "icon": "extension-icon.png",
  "author": "kovar",
  "platforms": ["macOS"],
  "categories": ["Productivity", "System"],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish",
    "test": "bun test"
  },
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/bun": "latest",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "commands": [
    {
      "name": "adjust-menu-bar-spacing",
      "title": "Adjust Menu Bar Spacing",
      "description": "Set custom spacing and selection padding for menu bar items",
      "mode": "view"
    }
  ]
}